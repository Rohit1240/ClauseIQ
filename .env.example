# Copy to .env and adjust. All variables are optional.

# --- backend (read by backend/app/core/config.py) ---
CLAUSEIQ_ENV=production
CLAUSEIQ_LOG_LEVEL=INFO
# Where trained checkpoints, metrics and dataset metadata live
CLAUSEIQ_ARTIFACTS_DIR=./artifacts
# SQLite database for uploaded documents and analysis history
CLAUSEIQ_DB_PATH=./data/app/clauseiq.sqlite3
# Upload limits
CLAUSEIQ_MAX_UPLOAD_MB=15
CLAUSEIQ_MAX_DOCUMENT_CHARS=2000000
# Comma-separated list of browser origins allowed to call the API (dev server by default)
CLAUSEIQ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Load all four models at startup (true) or on first use (false)
CLAUSEIQ_PRELOAD_MODELS=true
CLAUSEIQ_MAX_CONCURRENT_ANALYSES=2
# Torch CPU threads for inference (0 = PyTorch default)
CLAUSEIQ_TORCH_THREADS=0

# --- training / data (read by clauseiq/config.py) ---
# CLAUSEIQ_DATA_DIR=./data
# CLAUSEIQ_SEED=13
